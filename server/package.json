{
  "name": "doomsday-ready-server",
  "version": "1.0.0",
  "description": "Backend API for Doomsday Ready MCU rewatch planner and cinema booking optimizer",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
